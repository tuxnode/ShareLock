# ShareLock server configuration
# Copy to .env and adjust values as needed.
#
# Precedence (highest wins):
#   1. command-line flags   (e.g. -address :9090)
#   2. process environment  (e.g. SHARELOCK_ADDRESS=:9090)
#   3. this .env file
#   4. built-in defaults
#
# Custom file location: -env /path/to/file  or  SHARELOCK_ENV_FILE=/path/to/file

# Listen address (host:port)
SHARELOCK_ADDRESS=localhost:8080

# BadgerDB data directory
SHARELOCK_DIR=./data

# Enable TLS (true/false). When true, CERT and KEY are required.
SHARELOCK_TLS=true

# TLS certificate and private key (required if SHARELOCK_TLS=true)
SHARELOCK_CERT=cert.pem
SHARELOCK_KEY=key.pem
